<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Quản lý mặt hàng</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/shopman.css"></head><body>
<%@ include file="../fragments/header.jspf" %><div class="breadcrumb">SHOPMAN &nbsp;/&nbsp; Quản lý mặt hàng</div><div class="layout"><nav class="sidebar"><a class="active" href="${pageContext.request.contextPath}/manager/products">Quản lý mặt hàng</a><a href="${pageContext.request.contextPath}/manager/products/add">Thêm mặt hàng</a><a href="#">Nhà cung cấp</a><a href="#">Nhập hàng</a><a href="#">Thống kê</a></nav>
<main class="content"><div style="display:flex;justify-content:space-between;align-items:center"><h1>DANH SÁCH MẶT HÀNG</h1><a class="btn" href="${pageContext.request.contextPath}/manager/products/add">+ THÊM MẶT HÀNG</a></div>
<div class="table-wrap"><table class="table"><thead><tr><th>Mã MH</th><th>Tên mặt hàng</th><th>Loại</th><th>Đơn vị</th><th>Giá bán</th><th>Tồn kho</th></tr></thead><tbody><c:forEach items="${products}" var="p"><tr><td>${p.productCode}</td><td>${p.name}</td><td>${p.productType}</td><td>${p.unit}</td><td class="number"><fmt:formatNumber value="${p.price}" pattern="#,##0"/> đ</td><td class="number">${p.stockQuantity}</td></tr></c:forEach></tbody></table></div>
</main></div></body></html>
