<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Giỏ hàng</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/shopman.css"></head><body><%@ include file="../fragments/header.jspf" %><div class="breadcrumb">SHOPMAN &nbsp;/&nbsp; CartView8</div><main class="content">
<h1>GIỎ HÀNG</h1><p>Kiểm tra mặt hàng, số lượng, tổng tiền và xác nhận địa chỉ nhận hàng.</p><c:if test="${not empty flash}"><div class="flash ${flashType}">${flash}</div></c:if>
<div class="table-wrap"><table class="table"><thead><tr><th>STT</th><th>TÊN MẶT HÀNG</th><th>ĐƠN GIÁ</th><th>SỐ LƯỢNG</th><th>THÀNH TIỀN</th></tr></thead><tbody>
<c:forEach items="${cart.items}" var="item" varStatus="s"><tr><td>${s.count}</td><td>${item.product.name}</td><td><fmt:formatNumber value="${item.unitPrice}" pattern="#,##0"/> đ</td><td><form method="post" style="display:flex;gap:8px"><input type="hidden" name="action" value="update"><input type="hidden" name="itemId" value="${item.id}"><input class="qty" name="quantity" type="number" min="0" max="${item.product.stockQuantity}" value="${item.quantity}"><button class="btn small">Cập nhật</button></form></td><td class="number"><b><fmt:formatNumber value="${item.amount}" pattern="#,##0"/> đ</b></td></tr></c:forEach>
<tr class="total-row"><td colspan="4" class="number">TỔNG CỘNG</td><td class="number"><fmt:formatNumber value="${cart.totalAmount}" pattern="#,##0"/> đ</td></tr></tbody></table></div>
<c:choose><c:when test="${empty cart.items}"><div class="empty">Giỏ hàng đang trống. <a href="${pageContext.request.contextPath}/customer/products">Tiếp tục mua hàng</a></div></c:when><c:otherwise><form method="post" class="panel" style="margin-top:25px"><input type="hidden" name="action" value="checkout"><label><b>ĐỊA CHỈ NHẬN HÀNG (*)</b></label><input class="input" name="shippingAddress" value="${defaultAddress}" required maxlength="255"><div class="actions"><a class="btn secondary" href="${pageContext.request.contextPath}/customer/products">← TIẾP TỤC MUA HÀNG</a><button class="btn">SUBMIT – XÁC NHẬN ĐẶT HÀNG →</button></div></form></c:otherwise></c:choose>
</main></body></html>
