<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><title>Hóa đơn của tôi</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/shopman.css"></head><body><%@ include file="../fragments/header.jspf" %><div class="breadcrumb">SHOPMAN &nbsp;/&nbsp; Theo dõi hóa đơn</div><main class="content"><div style="display:flex;justify-content:space-between"><h1>HÓA ĐƠN CỦA TÔI</h1><a href="${pageContext.request.contextPath}/customer/products">← Tiếp tục mua hàng</a></div><table class="table"><thead><tr><th>Mã hóa đơn</th><th>Ngày đặt</th><th>Địa chỉ</th><th>Tổng tiền</th><th>Trạng thái</th></tr></thead><tbody><c:forEach items="${invoices}" var="i"><tr><td>${i.invoiceCode}</td><td>${i.orderDate}</td><td>${i.shippingAddress}</td><td><fmt:formatNumber value="${i.totalAmount}" pattern="#,##0"/> đ</td><td><b>${i.status}</b></td></tr></c:forEach></tbody></table></main></body></html>
