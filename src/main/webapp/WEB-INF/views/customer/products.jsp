<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Đặt mua hàng</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/shopman.css"></head><body><%@ include file="../fragments/header.jspf" %><div class="breadcrumb">SHOPMAN &nbsp;/&nbsp; ProductOrderView8</div>
<main class="content"><h1>TÌM MẶT HÀNG THEO TÊN</h1><form class="searchbar" method="get"><input class="input" name="keyword" value="${keyword}" placeholder="Nhập tên mặt hàng"><button class="btn secondary">TÌM</button><a class="btn cart-button" href="${pageContext.request.contextPath}/customer/cart">GIỎ ${cart.totalItems} →</a></form>
<c:if test="${not empty flash}"><div class="flash ${flashType}">${flash}</div></c:if><p><b>KẾT QUẢ TÌM KIẾM: “${keyword}” (${products.size()} sản phẩm)</b></p><div class="table-wrap"><table class="table"><thead><tr><th>MÃ MH</th><th>MẶT HÀNG</th><th>GIÁ BÁN</th><th>TỒN KHO</th><th>SL CHỌN</th><th>THAO TÁC</th></tr></thead><tbody>
<c:forEach items="${products}" var="p"><tr><td>${p.productCode}</td><td>${p.name}<br><small>${p.unit} · ${p.productType}</small></td><td><fmt:formatNumber value="${p.price}" pattern="#,##0"/> đ</td><td>${p.stockQuantity}</td><td colspan="2"><form method="post" style="display:flex;gap:12px"><input type="hidden" name="productId" value="${p.id}"><input type="hidden" name="keyword" value="${keyword}"><input class="qty" type="number" name="quantity" min="1" max="${p.stockQuantity}" value="1" required><button class="btn small" ${p.stockQuantity == 0 ? 'disabled' : ''}>CHO VÀO GIỎ</button></form></td></tr></c:forEach>
</tbody></table><c:if test="${empty products}"><div class="empty">Không tìm thấy mặt hàng phù hợp.</div></c:if></div><p style="margin-top:25px"><a href="${pageContext.request.contextPath}/customer/orders">Theo dõi trạng thái hóa đơn</a></p></main></body></html>
