<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><title>Duyệt hóa đơn</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/shopman.css"></head><body><%@ include file="../fragments/header.jspf" %><div class="breadcrumb">SHOPMAN &nbsp;/&nbsp; Hóa đơn trực tuyến</div><main class="content"><h1>DUYỆT HÓA ĐƠN TRỰC TUYẾN</h1><c:if test="${not empty flash}"><div class="flash ${flashType}">${flash}</div></c:if><table class="table"><thead><tr><th>Mã hóa đơn</th><th>Ngày đặt</th><th>Địa chỉ</th><th>Tổng tiền</th><th>Thao tác</th></tr></thead><tbody><c:forEach items="${invoices}" var="i"><tr><td>${i.invoiceCode}</td><td>${i.orderDate}</td><td>${i.shippingAddress}</td><td><fmt:formatNumber value="${i.totalAmount}" pattern="#,##0"/> đ</td><td><form method="post"><input type="hidden" name="invoiceId" value="${i.id}"><button class="btn small">DUYỆT & ĐÓNG HÀNG</button></form></td></tr></c:forEach></tbody></table><c:if test="${empty invoices}"><div class="empty">Không có hóa đơn đang chờ duyệt.</div></c:if></main></body></html>
